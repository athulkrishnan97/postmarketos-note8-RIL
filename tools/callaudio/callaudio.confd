# Settings for callaudio (voice call audio routing)

# Earpiece level, HPOUT3 Digital Volume: 0.5 dB steps, 128 = 0 dB,
# limited to 116 (-6 dB) by the machine driver
#EARPIECE_VOLUME=104

# Mic level, IN2L/IN3L Digital Volume: 0.5 dB steps, 128 = 0 dB
# (stock Android uses 140, +6 dB)
#MIC_VOLUME=152

# Send the stock HAL's sound setup to the CP when a call goes active (1/0)
#SEND_SND=1

# VDD_INT (S2MPS17 BUCK4 selector, 300 mV + 6.25 mV/step) during calls, so
# the ABOX's A7 can run at the 1.18 GHz the voice firmware asks for; restored
# afterwards. 0x50 = 800 mV (boot value 0x37 = 644 mV)
#VDD_INT_CALL=0x50
#PMIC_BUS=5
