#!/usr/bin/python3
# callaudio - voice call audio for the Galaxy Note 8 (greatlte).
#
# The CP's speech frames are handled by the voice firmware (VSS) on the ABOX
# DSP: it writes the downlink into the ABOX mixer (RDMA4) and reads the
# uplink from NSRC1 (WDMA2), both through UAIF0, the I2S link to the codec.
# The AP only has to keep that link running and route the codec:
#
#   downlink: UAIF0 -> AIF1RX1 -> HPOUT3L -> OUT3 demux HPOUT4 -> earpiece
#   uplink:   main mic (IN3L) -> AIF1TX1, second mic (IN2L) -> AIF1TX2 -> UAIF0
#
# As soon as a call exists (dialing, ringing in or out) this daemon arms the
# ABOX side, which has to be in place before VSS sets up its channel about a
# second after the call connects (started later, the uplink stays silent):
#   - raises VDD_INT and lets the ABOX's Cortex-A7 run at gear 1 (1.18 GHz),
#     which VSS asks for at call setup: at the 590 MHz gear-2 cap the uplink
#     (software ASRC and noise suppression on the A7) comes out choppy, and
#     at the boot VDD_INT (644 mV) gear 1 hangs the firmware
#   - enables the ABOX call DMAs (RDMA4/WDMA2) through the driver's "call"
#     attribute
# While a call is dialing, ringing out, active or held (not while it only
# rings in, so the ringtone keeps the speaker) it also:
#   - suspends PulseAudio's devices on the card, which hold hw:0,0
#   - saves the mixer controls it changes and sets the routes above
#   - runs a playback (silence) and a capture (discarded) stream on hw:0,0,
#     which keep UAIF0 and the codec's AIF1 clocked
#   - once a call is active, sends the stock HAL's sound setup to the CP
#     through mifmon (IPC SND: path handset, volume, mode, unmute)
# and undoes all of it when the last call ends. VDD_INT goes back down only
# once the A7 has left gear 1 (VSS drops it when the call is released).
#
# Settings: /etc/conf.d/callaudio. Log: /var/log/callaudio.log.

import mmap
import os
import pwd
import subprocess
import sys
import time

import dbus
import dbus.mainloop.glib
from gi.repository import GLib

CARD = "0"
PCM = "hw:0,0"
ABOX_CALL = "/sys/bus/platform/drivers/samsung-abox/13e50000.audio-controller/call"
MIFMON_CTL = "/run/mifmon.ctl"
GEAR_MIN = "/sys/module/snd_soc_samsung_abox/parameters/gear_min"
# ABOX A7 clock divider (CMU_DIV_CLK_ABOX_PLL): A7 = PLL_AUD / (n + 1)
ABOX_CPU_DIV = 0x13e01820
LOG = "/var/log/callaudio.log"

# HPOUT3 Digital Volume: 0.5 dB steps, 128 = 0 dB, limited to 116 (-6 dB)
EARPIECE_VOLUME = os.environ.get("EARPIECE_VOLUME") or "104"
# IN2L/IN3L Digital Volume: 0.5 dB steps, 128 = 0 dB (stock: 140, +6 dB)
MIC_VOLUME = os.environ.get("MIC_VOLUME") or "152"
SEND_SND = (os.environ.get("SEND_SND") or "1") == "1"
# VDD_INT is S2MPS17 BUCK4 (B4OUT 0x20, page 0x01 on the SPEEDY bus):
# 300 mV + 6.25 mV/step; boot value 0x37 = 644 mV, 0x50 = 800 mV
PMIC_BUS = os.environ.get("PMIC_BUS") or "5"
VDD_INT_CALL = os.environ.get("VDD_INT_CALL") or "0x50"

CONTROLS = [
	("OUT3 Demux", "HPOUT4"),
	("HPOUT3L Input 1", "AIF1RX1"),
	("HPOUT3L Input 2", "None"),
	("HPOUT3R Input 1", "None"),
	("HPOUT3 Digital Volume", f"{EARPIECE_VOLUME},{EARPIECE_VOLUME}"),
	("HPOUT3 Digital Switch", "on,on"),
	("Earpiece Switch", "on"),
	("IN2 Mode", "Digital"),
	("IN2 OSR", "3.072MHz"),
	("IN3 OSR", "3.072MHz"),
	("IN2L HPF Switch", "on"),
	("IN3L HPF Switch", "on"),
	("IN3L Digital Volume", MIC_VOLUME),
	("IN2L Digital Volume", MIC_VOLUME),
	("AIF1TX1 Input 1", "IN3L"),
	("AIF1TX2 Input 1", "IN2L"),
	("Main Mic Switch", "on"),
	("Sub Mic Switch", "on"),
]

# IPC SND (group 09) SET commands, as the stock audio HAL sends them at call
# start: path handset, volume 5, audio mode 0, TX unmute, RX unmute
SND_SETUP = ["fmt 09 03 03 01 00", "fmt 09 01 03 01 05", "fmt 09 0d 03 00 00",
	     "fmt 09 02 03 00", "fmt 09 02 03 02"]

MM = "org.freedesktop.ModemManager1"
MM_PATH = "/org/freedesktop/ModemManager1"
CALL_IFACE = MM + ".Call"
VOICE_IFACE = MM + ".Modem.Voice"
DIALING, RINGING_OUT, RINGING_IN, ACTIVE, HELD, TERMINATED = 1, 2, 3, 4, 5, 7
ARM_STATES = (DIALING, RINGING_OUT, RINGING_IN, ACTIVE, HELD)
AUDIO_STATES = (DIALING, RINGING_OUT, ACTIVE, HELD)


def log(msg):
	with open(LOG, "a") as f:
		f.write(time.strftime("%F %T ") + msg + "\n")


def run(args, **kw):
	return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
			      text=True, **kw)


def amixer_get(name):
	out = run(["amixer", "-c", CARD, "cget", f"name={name}"]).stdout
	for line in out.splitlines():
		line = line.strip()
		if line.startswith(": values="):
			return line[len(": values="):]
	return None


def amixer_set(name, value):
	r = run(["amixer", "-c", CARD, "-q", "cset", f"name={name}", value])
	if r.returncode:
		log(f"amixer {name}={value} failed: {r.stderr.strip()}")


def pulse_sessions():
	"""(uid, gid, env) of every running PulseAudio daemon."""
	out = run(["pgrep", "-x", "pulseaudio"]).stdout.split()
	for pid in out:
		try:
			st = os.stat(f"/proc/{pid}")
			with open(f"/proc/{pid}/environ", "rb") as f:
				penv = dict(e.split(b"=", 1) for e in f.read().split(b"\0") if b"=" in e)
		except OSError:
			continue
		pw = pwd.getpwuid(st.st_uid)
		env = {"PATH": "/usr/bin:/bin", "HOME": pw.pw_dir,
		       "XDG_RUNTIME_DIR": penv.get(b"XDG_RUNTIME_DIR", b"").decode()
		       or f"/run/user/{st.st_uid}"}
		yield st.st_uid, pw.pw_gid, env


def pactl(uid, gid, env, *args):
	def drop():
		os.setgid(gid)
		os.setuid(uid)
	return run(["pactl", *args], env=env, preexec_fn=drop, timeout=10)


def pulse_suspend(on):
	"""Suspend (or resume) PulseAudio's sinks and sources on the card."""
	for uid, gid, env in pulse_sessions():
		try:
			for kind in ("sink", "source"):
				out = pactl(uid, gid, env, "list", "short", kind + "s").stdout
				for line in out.splitlines():
					f = line.split("\t")
					if len(f) > 1 and "platform-sound" in f[1]:
						pactl(uid, gid, env, f"suspend-{kind}", f[1],
						      "1" if on else "0")
		except (OSError, subprocess.SubprocessError) as e:
			log(f"pactl failed: {e}")


def mifmon_send(lines):
	try:
		fd = os.open(MIFMON_CTL, os.O_WRONLY | os.O_NONBLOCK)
	except OSError as e:
		log(f"mifmon not reachable: {e}")
		return
	try:
		for l in lines:
			os.write(fd, (l + "\n").encode())
			time.sleep(0.3)
	finally:
		os.close(fd)


def read_phys32(addr):
	fd = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
	try:
		pg = addr & ~0xfff
		m = mmap.mmap(fd, 0x1000, mmap.MAP_SHARED, mmap.PROT_READ, offset=pg)
		v = int.from_bytes(m[addr - pg:addr - pg + 4], "little")
		m.close()
		return v
	finally:
		os.close(fd)


def vdd_int(value=None):
	"""Read (and with value, first write) the BUCK4 voltage selector."""
	if value is not None:
		run(["i2cset", "-a", "-f", "-y", PMIC_BUS, "0x01", "0x20", value])
	r = run(["i2cget", "-a", "-f", "-y", PMIC_BUS, "0x01", "0x20"])
	return r.stdout.strip() if r.returncode == 0 else None


def write_sysfs(path, value):
	try:
		with open(path, "w") as f:
			f.write(value)
	except OSError as e:
		log(f"{path} <- {value}: {e}")


class CallAudio:
	def __init__(self, bus):
		self.bus = bus
		self.calls = {}		# call path -> state
		self.snd_sent = set()	# calls that got the SND setup
		self.armed = False	# call DMAs started, VDD_INT raised
		self.on = False		# codec routed, streams running
		self.saved = []
		self.streams = {}
		self.vdd_int_boot = None	# BUCK4 value to restore, while raised
		bus.add_signal_receiver(self.state_changed, "StateChanged", CALL_IFACE,
					MM, path_keyword="path")
		bus.add_signal_receiver(self.call_deleted, "CallDeleted", VOICE_IFACE, MM)
		bus.add_signal_receiver(self.mm_owner, "NameOwnerChanged",
					"org.freedesktop.DBus", arg0=MM)
		self.resync()

	def resync(self):
		calls = {}
		try:
			om = dbus.Interface(self.bus.get_object(MM, MM_PATH),
					    "org.freedesktop.DBus.ObjectManager")
			for modem in om.GetManagedObjects():
				voice = dbus.Interface(self.bus.get_object(MM, modem), VOICE_IFACE)
				for c in voice.ListCalls():
					props = dbus.Interface(self.bus.get_object(MM, c),
							       "org.freedesktop.DBus.Properties")
					calls[str(c)] = int(props.Get(CALL_IFACE, "State"))
		except dbus.DBusException as e:
			log(f"resync: {e.get_dbus_name()}")
		self.calls = calls
		self.update()
		return True

	def mm_owner(self, name, old, new):
		log(f"ModemManager {'started' if new else 'stopped'}")
		self.calls = {}
		self.update()
		if new:
			GLib.timeout_add_seconds(3, lambda: self.resync() and False)

	def state_changed(self, old, new, reason, path=None):
		path = str(path)
		log(f"{path}: state {int(old)} -> {int(new)}")
		if int(new) == TERMINATED:
			self.calls.pop(path, None)
			self.snd_sent.discard(path)
		else:
			self.calls[path] = int(new)
		self.update()

	def call_deleted(self, path):
		self.calls.pop(str(path), None)
		self.snd_sent.discard(str(path))
		self.update()

	def update(self):
		states = self.calls.values()
		arm = any(s in ARM_STATES for s in states)
		audio = any(s in AUDIO_STATES for s in states)
		if arm and not self.armed:
			self.arm()
		if audio and not self.on:
			self.start()
		elif not audio and self.on:
			self.stop()
		if not arm and self.armed:
			self.disarm()
		if self.on and SEND_SND:
			for path, state in self.calls.items():
				if state == ACTIVE and path not in self.snd_sent:
					self.snd_sent.add(path)
					log("sending SND setup")
					mifmon_send(SND_SETUP)

	def arm(self):
		log("call path armed")
		self.armed = True
		self.boost(True)
		write_sysfs(ABOX_CALL, "1")
		GLib.timeout_add_seconds(10, self.watchdog)

	def disarm(self):
		log("call path disarmed")
		self.armed = False
		write_sysfs(ABOX_CALL, "0")
		self.boost(False)

	def start(self):
		log("call audio on")
		self.on = True
		pulse_suspend(True)
		self.saved = [(n, amixer_get(n)) for n, _ in CONTROLS]
		for n, v in CONTROLS:
			amixer_set(n, v)
		self.start_stream("playback", 5)
		self.start_stream("capture", 5)

	def start_stream(self, kind, tries):
		if not self.on:
			return False
		fmt = ["-q", "-D", PCM, "-c", "2", "-r", "48000", "-f", "S16_LE"]
		if kind == "playback":
			args = ["aplay", *fmt, "-t", "raw", "/dev/zero"]
		else:
			args = ["arecord", *fmt, "-t", "raw", "/dev/null"]
		p = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
		self.streams[kind] = p
		# PulseAudio may take a moment to release the device
		def check():
			if self.streams.get(kind) is p and p.poll() is not None:
				err = p.stderr.read().decode().strip()
				log(f"{kind} stream exited: {err}")
				if tries > 1:
					self.start_stream(kind, tries - 1)
			return False
		GLib.timeout_add(700, check)
		return False

	def watchdog(self):
		if not self.armed:
			return False
		for kind, p in list(self.streams.items()):
			if self.on and p.poll() is not None:
				log(f"{kind} stream died, restarting")
				self.start_stream(kind, 3)
		# a call can vanish without a signal (ModemManager restart)
		self.resync()
		return self.armed

	def stop(self):
		log("call audio off")
		self.on = False
		for p in self.streams.values():
			p.terminate()
		for p in self.streams.values():
			try:
				p.wait(2)
			except subprocess.TimeoutExpired:
				p.kill()
		self.streams = {}
		for n, v in self.saved:
			if v is not None:
				amixer_set(n, v)
		self.saved = []
		pulse_suspend(False)

	def boost(self, on):
		"""VDD_INT up and A7 gear 1 allowed during calls."""
		if on:
			if self.vdd_int_boot is None:
				self.vdd_int_boot = vdd_int()
			got = vdd_int(VDD_INT_CALL)
			if got is not None and int(got, 16) == int(VDD_INT_CALL, 16):
				write_sysfs(GEAR_MIN, "1")
				log(f"VDD_INT {self.vdd_int_boot} -> {got}, A7 gear 1 allowed")
			else:
				log(f"VDD_INT not raised ({got}), A7 stays capped at gear 2")
			return
		write_sysfs(GEAR_MIN, "2")
		# lower the voltage only once the A7 has left gear 1 (divider 0)
		deadline = time.monotonic() + 15

		def lower():
			if self.armed or self.vdd_int_boot is None:
				return False
			try:
				div = read_phys32(ABOX_CPU_DIV) & 0xf
			except OSError as e:
				log(f"A7 divider unreadable ({e}), VDD_INT stays raised")
				return False
			if div == 0:
				if time.monotonic() < deadline:
					return True
				log("A7 still at gear 1, VDD_INT stays raised")
				return False
			log(f"A7 divider {div}, VDD_INT -> {vdd_int(self.vdd_int_boot)}")
			self.vdd_int_boot = None
			return False
		GLib.timeout_add(500, lower)


def main():
	dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
	bus = dbus.SystemBus()
	log(f"started (earpiece volume {EARPIECE_VOLUME}, mic volume {MIC_VOLUME})")
	ca = CallAudio(bus)
	loop = GLib.MainLoop()

	def quit(*_):
		if ca.on:
			ca.stop()
		if ca.armed:
			ca.disarm()
		loop.quit()
	import signal
	GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, quit)
	GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, quit)
	loop.run()
	log("stopped")


if __name__ == "__main__":
	sys.exit(main())
