+
+#ifndef MM_BROADBAND_BEARER_SHANNON_H
+#define MM_BROADBAND_BEARER_SHANNON_H
+
+#include <glib.h>
+#include <glib-object.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-broadband-bearer.h"
+#include "mm-broadband-modem-shannon.h"
+
+#define MM_TYPE_BROADBAND_BEARER_SHANNON            (mm_broadband_bearer_shannon_get_type ())
+#define MM_BROADBAND_BEARER_SHANNON(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_BROADBAND_BEARER_SHANNON, MMBroadbandBearerShannon))
+#define MM_BROADBAND_BEARER_SHANNON_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  MM_TYPE_BROADBAND_BEARER_SHANNON, MMBroadbandBearerShannonClass))
+#define MM_IS_BROADBAND_BEARER_SHANNON(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_BROADBAND_BEARER_SHANNON))
+#define MM_IS_BROADBAND_BEARER_SHANNON_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_BROADBAND_BEARER_SHANNON))
+#define MM_BROADBAND_BEARER_SHANNON_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_BROADBAND_BEARER_SHANNON, MMBroadbandBearerShannonClass))
+
+typedef struct _MMBroadbandBearerShannon MMBroadbandBearerShannon;
