diff --git a/src/plugins/shannon/mm-broadband-bearer-shannon.c b/src/plugins/shannon/mm-broadband-bearer-shannon.c
new file mode 100644
index 0000000..3f12437
--- /dev/null
+++ b/src/plugins/shannon/mm-broadband-bearer-shannon.c
@@ -0,0 +1,347 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * Bearer for the Samsung Shannon CP of Exynos SoCs, run without Samsung's
+ * RIL. The CP routes a PDP context to its rmnet interface only when the
+ * context is set up over Samsung IPC; the RIL-side helper (mifmon) owns
+ * that and serves the AT port ModemManager uses. It implements:
+ *
+ *   AT+CGACT=1,<cid>     set up the IPC data call, OK once it is up
+ *   AT+CGCONTRDP=<cid>   address, gateway and DNS of that call
+ *   AT+CGACT=0,<cid>     release it
+ *   AT+CGACT?            state of the IPC data call
+ *
+ * Data then flows as raw IP on the net port (rmnet0), statically
+ * configured.
+ */
+
+#include <config.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-base-modem-at.h"
+#include "mm-bind.h"
+#include "mm-broadband-bearer-shannon.h"
+#include "mm-log-object.h"
+#include "mm-modem-helpers.h"
+
+G_DEFINE_TYPE (MMBroadbandBearerShannon, mm_broadband_bearer_shannon, MM_TYPE_BROADBAND_BEARER)
+
+typedef struct {
+    MMBaseModem      *modem;
+    MMPort           *data;
+    guint             cid;
+    MMBearerIpConfig *ip_config;
+} ConnectContext;
+
+static void
+connect_context_free (ConnectContext *ctx)
+{
+    g_clear_object (&ctx->modem);
+    g_clear_object (&ctx->data);
+    g_clear_object (&ctx->ip_config);
+    g_slice_free (ConnectContext, ctx);
+}
+
+static GTask *
+connect_task_new (MMBroadbandBearerShannon *self,
+                  MMBaseModem              *modem,
+                  MMPort                   *data,
+                  guint                     cid,
+                  GCancellable             *cancellable,
+                  GAsyncReadyCallback       callback,
+                  gpointer                  user_data)
+{
+    ConnectContext *ctx;
+    GTask          *task;
+
+    ctx = g_slice_new0 (ConnectContext);
+    ctx->modem = g_object_ref (modem);
+    ctx->data = data ? g_object_ref (data) : NULL;
+    ctx->cid = cid;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) connect_context_free);
+    return task;
+}
+
+/*****************************************************************************/
+/* 3GPP IP config: +CGCONTRDP */
+
+static gboolean
+get_ip_config_3gpp_finish (MMBroadbandBearer  *self,
+                           GAsyncResult       *res,
+                           MMBearerIpConfig  **ipv4_config,
+                           MMBearerIpConfig  **ipv6_config,
+                           GError            **error)
+{
+    MMBearerIpConfig *ipv4;
+
+    ipv4 = g_task_propagate_pointer (G_TASK (res), error);
+    if (!ipv4)
+        return FALSE;
+    if (ipv4_config)
+        *ipv4_config = ipv4;
+    else
+        g_object_unref (ipv4);
+    if (ipv6_config)
+        *ipv6_config = NULL;
+    return TRUE;
+}
+
+static void
+cgcontrdp_ready (MMBaseModem  *modem,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    MMBroadbandBearerShannon *self;
+    ConnectContext           *ctx;
+    const gchar              *response;
+    GError                   *error = NULL;
+    g_autofree gchar         *address = NULL;
+    g_autofree gchar         *subnet = NULL;
+    g_autofree gchar         *gateway = NULL;
+    gchar                    *dns[3] = { NULL, NULL, NULL };
+
+    self = g_task_get_source_object (task);
+    ctx = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_finish (modem, res, &error);
+    if (!response || !mm_3gpp_parse_cgcontrdp_response (response,
+                                                        NULL, NULL, NULL,
+                                                        &address,
+                                                        &subnet,
+                                                        &gateway,
+                                                        &dns[0],
+                                                        &dns[1],
+                                                        &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "PDP context #%u: address %s, subnet %s, gateway %s",
+                ctx->cid, address, subnet ? subnet : "-", gateway ? gateway : "-");
+
+    ctx->ip_config = mm_bearer_ip_config_new ();
+    mm_bearer_ip_config_set_method (ctx->ip_config, MM_BEARER_IP_METHOD_STATIC);
+    mm_bearer_ip_config_set_address (ctx->ip_config, address);
+    mm_bearer_ip_config_set_prefix (ctx->ip_config, subnet ? mm_netmask_to_cidr (subnet) : 32);
+    if (gateway)
+        mm_bearer_ip_config_set_gateway (ctx->ip_config, gateway);
+    mm_bearer_ip_config_set_dns (ctx->ip_config, (const gchar **) dns);
+    g_free (dns[0]);
+    g_free (dns[1]);
+
+    g_task_return_pointer (task, g_object_ref (ctx->ip_config), g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+get_ip_config_3gpp (MMBroadbandBearer   *self,
+                    MMBroadbandModem    *modem,
+                    MMPortSerialAt      *primary,
+                    MMPortSerialAt      *secondary,
+                    MMPort              *data,
+                    guint                cid,
+                    MMBearerIpFamily     ip_family,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    GTask            *task;
+    g_autofree gchar *cmd = NULL;
+
+    task = connect_task_new (MM_BROADBAND_BEARER_SHANNON (self), MM_BASE_MODEM (modem),
+                             data, cid, NULL, callback, user_data);
+
+    cmd = g_strdup_printf ("+CGCONTRDP=%u", cid);
+    mm_base_modem_at_command (MM_BASE_MODEM (modem),
+                              cmd,
+                              10,
+                              FALSE,
+                              (GAsyncReadyCallback) cgcontrdp_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* 3GPP dialing: +CGACT=1 */
+
+static MMPort *
+dial_3gpp_finish (MMBroadbandBearer  *self,
+                  GAsyncResult       *res,
+                  GError            **error)
+{
+    return MM_PORT (g_task_propagate_pointer (G_TASK (res), error));
+}
+
+static void
+cgact_activate_ready (MMBaseModem  *modem,
+                      GAsyncResult *res,
+                      GTask        *task)
+{
+    ConnectContext *ctx;
+    GError         *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_base_modem_at_command_finish (modem, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, g_object_ref (ctx->data), g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+dial_3gpp (MMBroadbandBearer   *self,
+           MMBaseModem         *modem,
+           MMPortSerialAt      *primary,
+           guint                cid,
+           GCancellable        *cancellable,
+           GAsyncReadyCallback  callback,
+           gpointer             user_data)
+{
+    MMPort           *data;
+    GTask            *task;
+    g_autofree gchar *cmd = NULL;
+
+    data = mm_base_modem_peek_best_data_port (modem, MM_PORT_TYPE_NET);
+    if (!data) {
+        g_task_report_new_error (self, callback, user_data, dial_3gpp,
+                                 MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND,
+                                 "No valid data port found to launch connection");
+        return;
+    }
+
+    task = connect_task_new (MM_BROADBAND_BEARER_SHANNON (self), modem,
+                             data, cid, cancellable, callback, user_data);
+
+    cmd = g_strdup_printf ("+CGACT=1,%u", cid);
+    mm_obj_dbg (self, "activating PDP context #%u...", cid);
+    mm_base_modem_at_command (modem,
+                              cmd,
+                              MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                              FALSE,
+                              (GAsyncReadyCallback) cgact_activate_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* 3GPP disconnection: +CGACT=0 */
+
+static gboolean
+disconnect_3gpp_finish (MMBroadbandBearer  *self,
+                        GAsyncResult       *res,
+                        GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+cgact_deactivate_ready (MMBaseModem  *modem,
+                        GAsyncResult *res,
+                        GTask        *task)
+{
+    MMBroadbandBearerShannon *self;
+    GError                   *error = NULL;
+
+    self = g_task_get_source_object (task);
+
+    if (!mm_base_modem_at_command_finish (modem, res, &error)) {
+        /* The last LTE PDN cannot be released; it is down from the user's
+         * point of view all the same. */
+        mm_obj_dbg (self, "ignored error when disconnecting: %s", error->message);
+        g_clear_error (&error);
+    }
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+disconnect_3gpp (MMBroadbandBearer   *self,
+                 MMBroadbandModem    *modem,
+                 MMPortSerialAt      *primary,
+                 MMPortSerialAt      *secondary,
+                 MMPort              *data,
+                 guint                cid,
+                 GAsyncReadyCallback  callback,
+                 gpointer             user_data)
+{
+    GTask            *task;
+    g_autofree gchar *cmd = NULL;
+
+    task = connect_task_new (MM_BROADBAND_BEARER_SHANNON (self), MM_BASE_MODEM (modem),
+                             data, cid, NULL, callback, user_data);
+
+    cmd = g_strdup_printf ("+CGACT=0,%u", cid);
+    mm_base_modem_at_command (MM_BASE_MODEM (modem),
+                              cmd,
+                              MM_BASE_BEARER_DEFAULT_DISCONNECTION_TIMEOUT,
+                              FALSE,
+                              (GAsyncReadyCallback) cgact_deactivate_ready,
+                              task);
+}
+
+/*****************************************************************************/
+
+MMBaseBearer *
+mm_broadband_bearer_shannon_new_finish (GAsyncResult  *res,
+                                        GError       **error)
+{
+    GObject *source;
+    GObject *bearer;
+
+    source = g_async_result_get_source_object (res);
+    bearer = g_async_initable_new_finish (G_ASYNC_INITABLE (source), res, error);
+    g_object_unref (source);
+
+    if (!bearer)
+        return NULL;
+
+    /* Only export valid bearers */
+    mm_base_bearer_export (MM_BASE_BEARER (bearer));
+
+    return MM_BASE_BEARER (bearer);
+}
+
+void
+mm_broadband_bearer_shannon_new (MMBroadbandModemShannon *modem,
+                                 MMBearerProperties      *config,
+                                 GCancellable            *cancellable,
+                                 GAsyncReadyCallback      callback,
+                                 gpointer                 user_data)
+{
+    g_async_initable_new_async (
+        MM_TYPE_BROADBAND_BEARER_SHANNON,
+        G_PRIORITY_DEFAULT,
+        cancellable,
+        callback,
+        user_data,
+        MM_BASE_BEARER_MODEM, modem,
+        MM_BIND_TO, modem,
+        MM_BASE_BEARER_CONFIG, config,
+        NULL);
+}
+
+static void
+mm_broadband_bearer_shannon_init (MMBroadbandBearerShannon *self)
+{
+}
+
+static void
+mm_broadband_bearer_shannon_class_init (MMBroadbandBearerShannonClass *klass)
+{
+    MMBroadbandBearerClass *broadband_bearer_class = MM_BROADBAND_BEARER_CLASS (klass);
+
+    broadband_bearer_class->dial_3gpp = dial_3gpp;
+    broadband_bearer_class->dial_3gpp_finish = dial_3gpp_finish;
+    broadband_bearer_class->get_ip_config_3gpp = get_ip_config_3gpp;
+    broadband_bearer_class->get_ip_config_3gpp_finish = get_ip_config_3gpp_finish;
+    broadband_bearer_class->disconnect_3gpp = disconnect_3gpp;
+    broadband_bearer_class->disconnect_3gpp_finish = disconnect_3gpp_finish;
+}
