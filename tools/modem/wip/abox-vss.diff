+static ssize_t start_vss_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct abox_data *data = dev_get_drvdata(dev);
+	int ret = 0;
+
+	if (!data->vss_mapped)
+		return -ENODEV;
+	data->vss_wanted = true;
+	if (data->state == ABOX_STATE_RUNNING)
+		abox_start_vss(data);
+	else
+		ret = abox_boot(data);	/* starts VSS once it is up */
+	return ret ? ret : count;
+}
+
+/* bring-up: start/stop the voice call DMAs by hand */
+static ssize_t call_store(struct device *dev, struct device_attribute *attr,
+			  const char *buf, size_t count)
+{
+	struct abox_data *data = dev_get_drvdata(dev);
+	bool on;
+	int ret = kstrtobool(buf, &on);
+
+	if (!ret)
+		ret = abox_pcm_call(data, on);
+	return ret ? ret : count;
+}
