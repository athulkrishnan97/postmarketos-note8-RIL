+/*
+ * The CP's voice path runs on the Calliope firmware: once cbd has loaded
+ * VSS and started the CP, the firmware has to be told to start it (and again
+ * after every boot of the firmware). Without it the CP crashes a few seconds
+ * into a call. The modem side asks through the start_vss attribute.
+ */
+static void abox_start_vss(struct abox_data *data)
+{
+	int ret;
+
+	if (!data->vss_mapped)
+		return;
+	ret = abox_ipc_system(data, ABOX_START_VSS, 0, 0, 0);
+	if (ret)
+		dev_warn(data->dev, "start VSS IPC failed: %d\n", ret);
+	else
+		dev_info(data->dev, "VSS started\n");
+}
