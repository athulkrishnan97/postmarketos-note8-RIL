_config="config-$_flavor.$arch"

# Source
source="
	$pkgname-$_commit.tar.gz::https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/snapshot/linux-$_commit.tar.gz
	$_config
	greatlte-dts.patch
