+# SPDX-License-Identifier: GPL-2.0
+menuconfig SEC_SIPC_MODEM_IF
+	bool "Samsung SIPC modem interface (Exynos integrated Shannon CP)"
+	depends on ARCH_EXYNOS && OF && NET
+	depends on EXYNOS_PMU
+	help
+	  Samsung's modem interface driver for the Shannon cellular
+	  processor (CP) integrated in Exynos SoCs such as the Exynos 8895.
+	  It boots the CP from shared memory and exposes the Android
+	  modem ABI: /dev/umts_boot0, /dev/umts_ipc0, /dev/umts_rfs0,
+	  /dev/umts_router and the rmnet0..7 raw-IP network interfaces.
+
+if SEC_SIPC_MODEM_IF
+
+config SEC_MODEM_SS310AP
+	bool "Exynos 8895 integrated SS310/SS355 CP"
+	default y
+	select UMTS_MODEM_SS310AP
+	select LINK_DEVICE_SHMEM
+	select CP_SECURE_BOOT
+	select LINK_DEVICE_NAPI
+	select MODEM_IF_QOS
+	select CP_ZEROCOPY
+
+config UMTS_MODEM_SS310AP
+	bool
+
+config LINK_DEVICE_SHMEM
+	bool
+
+config CP_SECURE_BOOT
+	bool
+
+config LINK_DEVICE_NAPI
+	bool
+
+config MODEM_IF_QOS
+	bool
+
+config CP_ZEROCOPY
+	bool
+
+endif
