diff --git a/drivers/misc/modem_v1/include/mif_compat.h b/drivers/misc/modem_v1/include/mif_compat.h
new file mode 100644
index 000000000..62883c6d9
--- /dev/null
+++ b/drivers/misc/modem_v1/include/mif_compat.h
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Shims for the Samsung modem interface driver (written for Linux 4.4)
+ * on mainline: Android wakelocks, the Exynos EL3 SMC helper and the
+ * vendor PMU accessors.
+ */
+#ifndef __MIF_COMPAT_H__
+#define __MIF_COMPAT_H__
+
+#include <linux/arm-smccc.h>
+#include <linux/device.h>
+#include <linux/hrtimer.h>
+#include <linux/timer.h>
+#include <linux/vmalloc.h>
+#include <linux/regmap.h>
+#include <linux/jiffies.h>
+#include <linux/soc/samsung/exynos-pmu.h>
+
+/* 4.x hrtimer_init(): the caller assigns ->function afterwards */
+static enum hrtimer_restart mif_hrtimer_nop(struct hrtimer *t)
+{
+	return HRTIMER_NORESTART;
+}
+
+static inline void mif_hrtimer_init(struct hrtimer *t, clockid_t clock,
+				    enum hrtimer_mode mode)
+{
+	hrtimer_setup(t, mif_hrtimer_nop, clock, mode);
+}
+#define hrtimer_init mif_hrtimer_init
+
+/* Android wakelocks -> wakeup sources */
+#define WAKE_LOCK_SUSPEND	0
+struct wake_lock {
+	struct wakeup_source *ws;
+};
+
+static inline void wake_lock_init(struct wake_lock *l, int type,
+				  const char *name)
+{
+	l->ws = wakeup_source_register(NULL, name);
+}
+
+static inline void wake_lock_destroy(struct wake_lock *l)
+{
+	wakeup_source_unregister(l->ws);
+	l->ws = NULL;
+}
+
+static inline void wake_lock(struct wake_lock *l)
+{
+	if (l->ws)
+		__pm_stay_awake(l->ws);
+}
+
+static inline void wake_unlock(struct wake_lock *l)
+{
+	if (l->ws)
+		__pm_relax(l->ws);
+}
+
+static inline void wake_lock_timeout(struct wake_lock *l, long timeout)
+{
+	if (l->ws)
+		__pm_wakeup_event(l->ws, jiffies_to_msecs(timeout));
+}
+
+static inline int wake_lock_active(struct wake_lock *l)
+{
+	return l->ws ? l->ws->active : 0;
+}
+
+/* EL3 monitor calls (vendor exynos_smc) */
+static inline int exynos_smc(unsigned long cmd, unsigned long arg1,
+			     unsigned long arg2, unsigned long arg3)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(cmd, arg1, arg2, arg3, 0, 0, 0, 0, &res);
+	return (int)res.a0;
+}
+
+/* Vendor PMU accessors on top of the mainline PMU regmap */
+static inline int exynos_pmu_read(unsigned int offset, unsigned int *val)
+{
+	struct regmap *pmu = exynos_get_pmu_regmap();
+
+	if (IS_ERR_OR_NULL(pmu))
+		return -ENODEV;
+	return regmap_read(pmu, offset, val);
+}
+
+static inline int exynos_pmu_write(unsigned int offset, unsigned int val)
+{
+	struct regmap *pmu = exynos_get_pmu_regmap();
+
+	if (IS_ERR_OR_NULL(pmu))
+		return -ENODEV;
+	return regmap_write(pmu, offset, val);
+}
+
+/*
+ * Vendor PM QoS classes (CPU cluster / MIF / INT minimum frequency) that
+ * the CP requests through the mailbox. Mainline has no equivalent DVFS
+ * here yet: log the request and ignore it.
+ */
+enum {
+	PM_QOS_CLUSTER0_FREQ_MIN = 100,
+	PM_QOS_CLUSTER1_FREQ_MIN,
+	PM_QOS_BUS_THROUGHPUT,
+	PM_QOS_DEVICE_THROUGHPUT,
+};
+
+struct mif_qos_request {
+	int class;
+	s32 value;
+};
+
+static inline void mif_qos_add_request(struct mif_qos_request *r, int class,
+				       s32 value)
+{
+	r->class = class;
+	r->value = value;
+}
+
+static inline void mif_qos_update_request(struct mif_qos_request *r,
+					  s32 value)
+{
+	if (r->value != value)
+		pr_debug("mif: CP DVFS request class %d -> %d (ignored)\n",
+			 r->class, value);
+	r->value = value;
+}
+
+#endif /* __MIF_COMPAT_H__ */
