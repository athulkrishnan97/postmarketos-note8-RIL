+#define IOCTL_CPLOG_FULL_DUMP		_IO('o', 0x59)  /* for cplog memory dump */
+
+/*
+Definitions for IO devices
+*/
+#define MAX_IOD_RXQ_LEN		2048
+
+#define CP_CRASH_INFO_SIZE	512
