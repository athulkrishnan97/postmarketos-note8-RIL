+static void modem_shutdown(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct modem_ctl *mc = dev_get_drvdata(dev);
+
+	mc->ops.modem_shutdown(mc);
+	mc->phone_state = STATE_OFFLINE;
+
+	clean_vss_magic_code();
+
+	mif_err("%s\n", mc->name);
+}
