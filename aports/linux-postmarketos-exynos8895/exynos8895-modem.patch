From: Athul <athulkrishnan97@users.noreply.github.com>
Date: Fri, 9 Oct 2026 21:30:00 +0100
Subject: [PATCH] exynos8895: Shannon CP modem interface (Samsung modem_v1)

Samsung's modem interface driver from the universal8895 kernel
(lineage-19.1: drivers/misc/modem_v1, drivers/misc/mcu_ipc, pmu-cp),
ported to 7.0: mailbox, CP shared memory, CP power control through the
EL3 monitor, SIPC5 legacy/SBD links, /dev/umts_* and rmnet0..7.
Plus the greatlte modem DT (stock modem-ss355ap-pdata.dtsi) and the
modem_if reservation in the stock (mapped) layout.

Changes against the vendor code: 7.0 API updates, wakelocks ->
wakeup sources, exynos_smc -> arm_smccc_smc, PMU via regmap, PM QoS /
ECT / ACPM / snapshot hooks stubbed, no AP panic on CP errors, always
copy zero-copy RX (no skb_free_head hook), CP IRQs requested
disabled, mailbox acks unclaimed sources, CP main offset from DT.
---
diff --git a/arch/arm64/boot/dts/exynos/exynos8895-greatlte-modem.dtsi b/arch/arm64/boot/dts/exynos/exynos8895-greatlte-modem.dtsi
new file mode 100644
index 000000000..4a3cb03c9
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos8895-greatlte-modem.dtsi
@@ -0,0 +1,392 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Note 8 (greatlte): integrated Shannon 355 CP (modem).
+ * Platform data from the stock modem-ss355ap-pdata.dtsi (universal8895).
+ *
+ * Shared memory (modem_if carveout, 0xf4c00000, 144 MiB):
+ *   +0x0000000  CP boot/main image (122 MiB)
+ *   +0x7a00000  VSS (voice) image   (6 MiB)
+ *   +0x8000000  IPC region          (5 MiB: legacy boot map, then SBD rings)
+ *   +0x8500000  zero-copy buffers   (11 MiB)
+ */
+
+/ {
+	mailbox_cp: mcu_ipc@15b40000 {
+		compatible = "samsung,exynos-shd-ipc-mailbox";
+		reg = <0x0 0x15b40000 0x180>;
+		mcu,name = "mcu_ipc_cp";
+		mcu,id = <0>;
+		interrupts = <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	shmem: shmem@f6e00000 {
+		compatible = "samsung,exynos-shm_ipc";
+		shmem,cp_size = <0x7a00000>;	/* CP 122 MiB */
+		shmem,vss_size = <0x600000>;	/* VSS 6 MiB */
+		shmem,ipc_offset = <0x8000000>;	/* 128 MiB (CP + VSS) */
+		shmem,ipc_size = <0x500000>;	/* 5 MiB */
+		shmem,zmb_offset = <0x8500000>;	/* 133 MiB (CP + VSS + IPC) */
+		shmem,zmb_size = <0xb00000>;	/* 11 MiB */
+	};
+
+	mif_pdata {
+		/* CP main image offset in the boot region (stock: zero-size reg) */
+		mif,cp_main_offset = <0x10000>;
+
+		compatible = "sec_modem,modem_pdata";
+		/* CP_REV0-3, AP_REV0-3 (board revision straps) */
+		gpios = <&gpf1 1 0>, <&gpf1 2 0>, <&gpf1 3 0>, <&gpf1 7 0>,
+			<&gpd0 0 0>, <&gpd0 1 0>, <&gpd0 2 0>, <&gpd0 3 0>;
+		memory-region = <&modem_if>;
+		status = "okay";
+		interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>,	/* CP_FAIL (INTREQ_ALIVE_CP_ACTIVE) */
+			     <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;	/* CP_WDT (INTREQ_CP2AP_RESET_REQ) */
+
+		/* common pdata */
+		mif,name = "ss355ap";
+		mif,modem_net = <0>;		/* UMTS_NETWORK */
+		mif,modem_type = <10>;		/* SEC_SS310AP */
+		mif,use_handover = <0>;		/* not used */
+		mif,ipc_version = <50>;		/* SIPC 5.0 */
+		mif,link_types = <0x200>;	/* LINKDEV_SHMEM */
+		mif,link_name = "shmem";
+		mif,link_attrs = <0x7C9>;	/* XMIT_BTDLR(0x400) | DUMP_ALIGNED (0x200) | BOOT_ALIGNED (0x100) | MEM_DUMP (0x80) | MEM_BOOT (0x40) | DPRAM_MAGIC (0x08) | SBD_IPC (0x01) */
+		mif,num_iodevs = <20>;
+
+		/* MIF buffer information */
+		mif,buff_offset = <0x500000>;
+		mif,buff_size = <0x900000>;
+
+		/* buff pool 2nd information */
+		mif,bufpool_2nd_base = <0>;	/* stock 0xE9000000: overlaps abox/video carveouts, unused */
+		mif,bufpool_2nd_size = <0>;
+
+		/* mbox pdata */
+		mbx_ap2cp_msg = <0>;
+		mbx_cp2ap_msg = <1>;
+		mbx_ap2cp_united_status = <2>;
+		mbx_cp2ap_united_status = <3>;
+		mbx_ap2cp_mif_value = <4>;
+		mbx_ap2cp_kerneltime = <9>;
+
+		mif,int_ap2cp_msg = <0>;
+		mif,int_ap2cp_wakeup = <1>;
+		mif,int_ap2cp_status = <2>;
+		mif,int_ap2cp_active = <3>;
+
+		mif,irq_cp2ap_msg = <0>;
+		mif,irq_cp2ap_status = <2>;
+		mif,irq_cp2ap_active = <4>;
+		mif,irq_cp2ap_wakelock = <8>;
+		mif,irq_cp2ap_ratmode = <9>;
+
+		/* mbox pdata for performance request */
+		mbx_cp2ap_dvfsreq_cpu = <5>;
+		mbx_cp2ap_dvfsreq_mif = <6>;
+		mbx_cp2ap_dvfsreq_int = <7>;
+
+		mif,irq_cp2ap_perf_req_cpu = <5>; /* CP2AP_DVFSREQ_CPU */
+		mif,irq_cp2ap_perf_req_mif = <6>; /* CP2AP_DVFSREQ_MIF */
+		mif,irq_cp2ap_perf_req_int = <7>; /* CP2AP_DVFSREQ_INT */
+
+
+		/* mbox pdata for sbi(status bit info) */
+		sbi_cp_rat_mode_mask = <0x3f>;
+		sbi_cp_rat_mode_pos = <26>;
+		sbi_cp_evs_mode_mask = <0x1>;
+		sbi_cp_evs_mode_pos = <7>;
+		sbi_cp_wakelock_mask = <0x1>;
+		sbi_cp_wakelock_pos = <6>;
+		sbi_lte_active_mask = <0x1>;
+		sbi_lte_active_pos = <5>;
+		sbi_cp_status_mask = <0xf>;
+		sbi_cp_status_pos = <1>;
+		sbi_cp2ap_wakelock_mask = <0x1>;
+		sbi_cp2ap_wakelock_pos = <6>;
+		sbi_pda_active_mask = <0x1>;
+		sbi_pda_active_pos = <5>;
+		sbi_ap_status_mask = <0xf>;
+		sbi_ap_status_pos = <1>;
+
+		sbi_crash_type_mask = <0xf>;
+		sbi_crash_type_pos = <23>;
+		sbi_device_type_mask = <0x1f>;
+		sbi_device_type_pos = <18>;
+		sbi_ext_backtrace_mask = <0x1>;
+		sbi_ext_backtrace_pos = <17>;
+		sbi_ds_det_mask = <0x3>;
+		sbi_ds_det_pos = <14>;
+		sbi_sys_rev_mask = <0xff>;
+		sbi_sys_rev_pos = <6>;
+
+		sbi_lockval_cp2ap_dvfsreq_endian_mask = <0x1>;
+		sbi_lockval_cp2ap_dvfsreq_endian_pos = <31>;
+		sbi_lockval_cp2ap_dvfsreq_index_mask = <0x7fff>;
+		sbi_lockval_cp2ap_dvfsreq_index_pos = <0>;
+
+		sbi_ap2cp_kerneltime_sec_mask = <0xfff>;
+		sbi_ap2cp_kerneltime_sec_pos = <20>;
+		sbi_ap2cp_kerneltime_usec_mask = <0xfffff>;
+		sbi_ap2cp_kerneltime_usec_pos = <0>;
+
