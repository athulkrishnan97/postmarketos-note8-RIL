+	    !pm_runtime_status_suspended(data->dev))
+		return NOTIFY_OK;
+
+	exynos_arm64_cmu_resume(data->dev);
+	clk_disable_unprepare(data->clk);
+
+	return NOTIFY_OK;
+}
