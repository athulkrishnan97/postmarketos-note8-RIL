+/*
+ * During system resume genpd powers a domain back on without resuming a
+ * runtime-suspended CMU in it, so the CMU registers come up at their reset
+ * values. Some of them (Q-channel controls) must hold their saved values for
+ * the next power-down of the domain to complete; restore the context here.
+ */
+static int exynos_arm64_cmu_genpd_notify(struct notifier_block *nb,
+					 unsigned long action, void *unused)
+{
+	struct exynos_arm64_cmu_data *data =
+		container_of(nb, struct exynos_arm64_cmu_data, genpd_nb);
