+
 static char *mfc_mem_size;
 module_param_named(mem, mfc_mem_size, charp, 0644);
 MODULE_PARM_DESC(mem, "Preallocated memory size for the firmware and context buffers");
@@ -545,8 +555,23 @@
 		else
 			ctx->state = MFCINST_HEAD_PARSED;
 
