diff -Naur a/drivers/media/platform/samsung/s5p-mfc/regs-mfc-v11.h b/drivers/media/platform/samsung/s5p-mfc/regs-mfc-v11.h
--- a/drivers/media/platform/samsung/s5p-mfc/regs-mfc-v11.h
+++ b/drivers/media/platform/samsung/s5p-mfc/regs-mfc-v11.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Register definition file for Samsung MFC V11.x Interface (FIMV) driver
+ * (Exynos8895). The register map is the one of MFC v10; the context sizes
+ * and the H.264 MV padding are those of MFC v12.
+ */
+
+#ifndef _REGS_MFC_V11_H
+#define _REGS_MFC_V11_H
+
+#include <linux/sizes.h>
+#include "regs-mfc-v10.h"
+
+/* MFCv11 Context buffer sizes */
+#define MFC_CTX_BUF_SIZE_V11		(30 * SZ_1K)
+#define MFC_H264_DEC_CTX_BUF_SIZE_V11	(2 * SZ_1M)
+#define MFC_OTHER_DEC_CTX_BUF_SIZE_V11	(30 * SZ_1K)
+#define MFC_H264_ENC_CTX_BUF_SIZE_V11	(100 * SZ_1K)
+#define MFC_HEVC_ENC_CTX_BUF_SIZE_V11	(40 * SZ_1K)
+#define MFC_OTHER_ENC_CTX_BUF_SIZE_V11	(25 * SZ_1K)
+
+/* MFCv11 variant defines */
+#define MAX_FW_SIZE_V11			(SZ_1M)
+#define MAX_CPB_SIZE_V11		(3 * SZ_1M)
+#define MFC_VERSION_V11			0xB0
+#define MFC_NUM_PORTS_V11		1
+
+/* Hardware version, read back after SYS_INIT (0x1100 on Exynos8895) */
+#define S5P_FIMV_MFC_VERSION_V11	0xF028
+/* Outstanding bus transactions of the codec; 0 when idle */
+#define S5P_FIMV_MFC_BUS_STATUS_V11	0x7018
+#define S5P_FIMV_MFC_RPEND_V11		0x7028
+#define S5P_FIMV_MFC_WPEND_V11		0x702C
+/* Decoder watchdog in MFC clock cycles; cleared by every reset */
+#define S5P_FIMV_DEC_TIMEOUT_VALUE_V11	0xF03C
+#define MFC_DEC_TIMEOUT_V11		200000000
+/* DEC_OPTIONS bits the vendor driver always sets */
+#define S5P_FIMV_D_OPT_CONCEAL_SHIFT_V11	8	/* 4: fixed colour */
+#define S5P_FIMV_D_OPT_REALLOC_SHIFT_V11	13
+#define S5P_FIMV_D_OPT_SPECIAL_PARSING_SHIFT_V11	15	/* incl. PPS */
+#define S5P_FIMV_D_FORCE_PIXEL_VAL_V11	0xF0C8
+#define MFC_CONCEAL_COLOR_V11		0x8020000
+#define S5P_FIMV_D_SEI_RECOVERY_PARSING_SHIFT_V11	2
+/* DEC_OPTIONS: 2 = firmware parallel processing off */
+#define S5P_FIMV_D_OPT_PARALLEL_SHIFT_V11	11
+#define S5P_FIMV_D_OPT_PARALLEL_DISABLE_V11	2
+
+#endif /*_REGS_MFC_V11_H*/
diff -Naur a/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c b/drivers/media/platform/samsung/s5p-mfc/s5p_mfc.c
