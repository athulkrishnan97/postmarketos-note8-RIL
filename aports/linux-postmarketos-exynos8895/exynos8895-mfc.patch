+	(1 << S5P_FIMV_D_OPT_REALLOC_SHIFT_V11) |
+	(1 << S5P_FIMV_D_OPT_SPECIAL_PARSING_SHIFT_V11);
+module_param_named(v11_dec_opts, mfc_v11_dec_opts, uint, 0644);
+MODULE_PARM_DESC(v11_dec_opts, "MFC v11: extra DEC_OPTIONS bits (vendor defaults)");
+unsigned int mfc_v11_sei = 1 << S5P_FIMV_D_SEI_RECOVERY_PARSING_SHIFT_V11;
+module_param_named(v11_sei, mfc_v11_sei, uint, 0644);
