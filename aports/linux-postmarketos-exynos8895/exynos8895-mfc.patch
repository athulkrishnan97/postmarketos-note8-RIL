+/*
+ * Stop the v11 RISC once its bus traffic has drained. The firmware keeps
+ * running after the last close; resetting the codec or turning it off
+ * with transactions in flight stalls the interconnect.
+ */
+static void s5p_mfc_v11_risc_off(struct s5p_mfc_dev *dev)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(MFC_BW_TIMEOUT);
+	unsigned int status;
+
+	while ((status = mfc_read(dev, S5P_FIMV_MFC_BUS_STATUS_V11))) {
+		if (time_after(jiffies, timeout)) {
+			mfc_err("bus busy before RISC off: %#x (R %#x, W %#x)\n",
+				status, mfc_read(dev, S5P_FIMV_MFC_RPEND_V11),
+				mfc_read(dev, S5P_FIMV_MFC_WPEND_V11));
+			break;
+		}
+		cpu_relax();
+	}
+	mfc_write(dev, 0, S5P_FIMV_RISC_ON_V6);
+}
