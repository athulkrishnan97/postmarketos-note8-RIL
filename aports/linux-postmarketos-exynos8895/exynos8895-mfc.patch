 	}
+fw_ready:
 	/* Init videobuf2 queue for CAPTURE */
 	q = &ctx->vq_dst;
 	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
@@ -995,7 +1032,11 @@
 		if (dev->curr_ctx == ctx->num)
 			clear_bit(0, &dev->hw_lock);
 		dev->num_inst--;
-		if (dev->num_inst == 0) {
+		if (dev->num_inst == 0 && dev->fw_resident) {
+			mfc_debug(2, "Last instance, firmware stays resident\n");
