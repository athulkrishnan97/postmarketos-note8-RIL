@@ -177,6 +179,13 @@ static const struct snd_soc_dapm_route exynos8895_madera_routes[] = {
 	{ "Earpiece", NULL, "HPOUT3R" },
 	{ "Earpiece", NULL, "HPOUT4L" },
 	{ "Earpiece", NULL, "HPOUT4R" },
+	/* digital mics: main on IN3L (IN1AR pins), second on IN2L (IN2AL pins) */
+	{ "Main Mic", NULL, "MICBIAS1A" },
+	{ "IN1ARN", NULL, "Main Mic" },
+	{ "IN1ARP", NULL, "Main Mic" },
+	{ "Sub Mic", NULL, "MICBIAS1B" },
+	{ "IN2ALN", NULL, "Sub Mic" },
+	{ "IN2ALP", NULL, "Sub Mic" },
 };
 
 
@@ -184,6 +193,8 @@ static const struct snd_kcontrol_new exynos8895_madera_controls[] = {
 	SOC_DAPM_PIN_SWITCH("Headphone"),
 	SOC_DAPM_PIN_SWITCH("Earpiece"),
 	SOC_DAPM_PIN_SWITCH("Speaker"),
+	SOC_DAPM_PIN_SWITCH("Main Mic"),
+	SOC_DAPM_PIN_SWITCH("Sub Mic"),
 };
 
 SND_SOC_DAILINK_DEFS(codec,
