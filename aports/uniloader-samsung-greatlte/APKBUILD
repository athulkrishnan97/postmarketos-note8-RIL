# Reference: <https://postmarketos.org/vendorkernel>
maintainer="athul <athul@postmarketos.org>"
pkgname=uniloader-samsung-greatlte
pkgver=0.0.1
pkgrel=3
pkgdesc="Samsung Greatlte AArch64 boot shim"
url="https://github.com/ivoszbg/uniLoader/"
arch="aarch64"
license="GPL-2.0-only"
makedepends="gcc lz4 linux-postmarketos-exynos8895"
options="!check"
_commit="e8466561575ed4e2e23217b54b751ea30273549e"
_dtb="exynos8895-greatlte.dtb"
source="
	uniLoader-$_commit.tar.gz::https://github.com/ivoszbg/uniLoader/archive/$_commit.tar.gz
	greatlte.patch
"
builddir="$srcdir/uniLoader-$_commit"

build() {
	unset LDFLAGS
	# Stage kernel Image and devicetree blob from the exynos8895 kernel
	# package before invoking uniLoader's own make-based build
	# The kernel goes in LZ4-compressed (legacy format, unpacked by
	# uniLoader, CONFIG_KERNEL_LZ4): the boot image drops from ~41.6 MB
	# to ~17 MB, well inside the 40 MiB BOOT partition
	lz4 -l -9 -f -q "/boot/vmlinuz" blob/Image
	cp "/boot/dtbs/exynos/$_dtb" blob/dtb
	touch blob/ramdisk

	# Native aarch64 gcc runs in the (cross-native) build chroot
	make ARCH=aarch64 CROSS_COMPILE= greatlte_defconfig
	make ARCH=aarch64 CROSS_COMPILE=
}

package() {
	mkdir -p "$pkgdir"/boot
	install -Dm644 "$builddir/uniLoader" \
		"$pkgdir/boot/bootshim"
}

sha512sums="
