diff --git a/lib/lz4/lz4.c b/lib/lz4/lz4.c
new file mode 100644
index 0000000..91b13a1
--- /dev/null
+++ b/lib/lz4/lz4.c
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * LZ4 decompressor for the "legacy" frame format (lz4 -l), the one Linux
+ * uses for compressed kernels: a magic number, then blocks of at most
+ * 8 MiB of output, each prefixed by its compressed size and decoded on
+ * its own.
+ *
+ * Byte accesses only: this runs before the MMU is on, where memory is
+ * Device memory and unaligned or wider accesses would fault.
+ */
+
+#include <stdint.h>
+#include <lib/lz4.h>
+
+#define LZ4_LEGACY_MAGIC	0x184c2102u
+#define LZ4_LEGACY_BLOCK	(8u << 20)
+#define LZ4_MIN_MATCH		4
+
+static uint32_t get_le32(const uint8_t *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* One LZ4 block; returns the decoded size or -1 for corrupt input. */
+static long lz4_block(const uint8_t *ip, unsigned long srclen,
+		      uint8_t *dst, unsigned long dstmax)
+{
+	const uint8_t *iend = ip + srclen;
+	uint8_t *op = dst, *oend = dst + dstmax;
+
+	for (;;) {
+		unsigned long len, off;
+		unsigned int token;
+		const uint8_t *match;
+		uint8_t b;
+
+		if (ip >= iend)
+			return -1;
+		token = *ip++;
+
+		/* literals */
+		len = token >> 4;
+		if (len == 15) {
+			do {
+				if (ip >= iend)
+					return -1;
+				b = *ip++;
+				len += b;
+			} while (b == 255);
+		}
+		if (len > (unsigned long)(iend - ip) ||
+		    len > (unsigned long)(oend - op))
+			return -1;
+		while (len--)
+			*op++ = *ip++;
+
+		/* the last sequence has literals only */
+		if (ip == iend)
+			break;
+
+		/* match */
+		if (iend - ip < 2)
+			return -1;
+		off = ip[0] | ip[1] << 8;
+		ip += 2;
+		if (!off || off > (unsigned long)(op - dst))
+			return -1;
+		len = token & 15;
+		if (len == 15) {
+			do {
+				if (ip >= iend)
+					return -1;
+				b = *ip++;
+				len += b;
+			} while (b == 255);
+		}
+		len += LZ4_MIN_MATCH;
+		if (len > (unsigned long)(oend - op))
+			return -1;
+		match = op - off;
+		while (len--)
+			*op++ = *match++;
+	}
+
+	return op - dst;
+}
+
+long lz4_legacy_decompress(const void *src, unsigned long srclen,
+			   void *dst, unsigned long dstmax)
+{
+	const uint8_t *ip = src, *iend = ip + srclen;
+	uint8_t *op = dst;
+	unsigned long left = dstmax;
+
+	if (srclen < 4 || get_le32(ip) != LZ4_LEGACY_MAGIC)
+		return -1;
+	ip += 4;
+
+	/* the section may be padded after the last block */
+	while (iend - ip >= 4) {
+		uint32_t size = get_le32(ip);
+		unsigned long max;
+		long n;
+
+		ip += 4;
+		if (size == LZ4_LEGACY_MAGIC)	/* concatenated streams */
+			continue;
+		if (!size)
+			break;
+		if (size > (unsigned long)(iend - ip))
+			return -1;
+		max = left < LZ4_LEGACY_BLOCK ? left : LZ4_LEGACY_BLOCK;
+		n = lz4_block(ip, size, op, max);
+		if (n < 0)
+			return -1;
+		ip += size;
+		op += n;
+		left -= n;
+	}
+
+	return op - (uint8_t *)dst;
+}
