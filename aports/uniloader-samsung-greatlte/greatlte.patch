diff --git a/arch/aarch64/load-kernel.c b/arch/aarch64/load-kernel.c
index 8eee041..1a15bad 100644
--- a/arch/aarch64/load-kernel.c
+++ b/arch/aarch64/load-kernel.c
@@ -7,9 +7,137 @@
 #include <main/boot.h>
 #include <string.h>
 
+#ifdef CONFIG_KERNEL_LZ4
+#include <stdint.h>
+#include <lib/debug.h>
+#include <lib/lz4.h>
+#include <main/main.h>
+#ifdef CONFIG_LIBFDT
+#include <lib/libfdt/libfdt.h>
+#endif
+
+extern char _stack_end[];
+
+void lz4_dcache_inval(uint64_t start, uint64_t end);
+void lz4_mmu_on(uint64_t *table);
+void lz4_mmu_off(uint64_t start1, uint64_t end1, uint64_t start2,
+		 uint64_t end2, uint64_t sctlr);
+
+#define SZ_2M			0x200000ull
+#define SZ_1G			0x40000000ull
+#define CACHED_GB		2	/* 0x80000000: payload and uniLoader */
+
+#define DESC_VALID		(1ull << 0)
+#define DESC_TABLE		(3ull << 0)
+#define DESC_AF			(1ull << 10)
+#define DESC_ISH		(3ull << 8)
+#define DESC_XN			(3ull << 53)
+#define DESC_ATTR(n)		((uint64_t)(n) << 2)
+#define BLOCK_DEVICE		(DESC_VALID | DESC_AF | DESC_XN | DESC_ATTR(0))
+#define BLOCK_NORMAL		(DESC_VALID | DESC_AF | DESC_ISH | DESC_ATTR(1))
+
+static uint64_t lz4_l1[512] __attribute__((aligned(4096)));
+static uint64_t lz4_l2[512] __attribute__((aligned(4096)));
+
+static int in_cached_gb(uint64_t start, uint64_t end)
+{
+	return start >= CACHED_GB * SZ_1G && end <= (CACHED_GB + 1) * SZ_1G;
+}
+
+/*
+ * Identity map of the 32-bit space as Device memory, except the two ranges
+ * the unpacking touches: those are cacheable, in 2 MiB blocks. Nothing else
+ * is Normal memory, so nothing else (secure carve-outs) is ever accessed
+ * speculatively.
+ */
+static void lz4_build_tables(uint64_t s1, uint64_t e1, uint64_t s2, uint64_t e2)
+{
+	uint64_t base = CACHED_GB * SZ_1G, a;
+	int i;
+
+	for (i = 0; i < 4; i++)
+		lz4_l1[i] = i * SZ_1G | BLOCK_DEVICE;
+	for (i = 0; i < 512; i++)
+		lz4_l2[i] = (base + i * SZ_2M) | BLOCK_DEVICE;
+	for (a = s1 & ~(SZ_2M - 1); a < e1; a += SZ_2M)
+		lz4_l2[(a - base) / SZ_2M] = a | BLOCK_NORMAL;
+	for (a = s2 & ~(SZ_2M - 1); a < e2; a += SZ_2M)
+		lz4_l2[(a - base) / SZ_2M] = a | BLOCK_NORMAL;
+	lz4_l1[CACHED_GB] = (uint64_t)lz4_l2 | DESC_TABLE;
+}
+
+static uint64_t read_cntvct(void)
+{
+	uint64_t v;
+
+	asm volatile("isb; mrs %0, cntvct_el0" : "=r"(v));
+	return v;
+}
+
+/*
+ * Leave the unpacking time (arch timer ticks) and the CPU state it started
+ * in under /chosen, for measuring from Linux.
+ */
+static void note_lz4(void *dt, uint64_t ticks, uint64_t sctlr, int cached)
+{
+#ifdef CONFIG_LIBFDT
+	int chosen = fdt_path_offset(dt, "/chosen");
+
+	if (chosen < 0)
+		return;
+	fdt_setprop_u64(dt, chosen, "uniloader,lz4-ticks", ticks);
+	fdt_setprop_u64(dt, chosen, "uniloader,sctlr", sctlr);
+	fdt_setprop_u32(dt, chosen, "uniloader,lz4-cached", cached);
+#endif
+}
+
+static long unpack_kernel(void *kernel, void *dt)
+{
+	uint64_t out = CONFIG_PAYLOAD_ENTRY;
+	uint64_t out_end = out + CONFIG_KERNEL_LZ4_MAX_SIZE;
+	uint64_t self = CONFIG_TEXT_BASE, self_end = (uint64_t)_stack_end;
+	uint64_t start = read_cntvct(), el, sctlr;
+	int cached;
+	long size;
+
+	asm volatile("mrs %0, CurrentEL" : "=r"(el));
+	asm volatile("mrs %0, sctlr_el1" : "=r"(sctlr));
+
+	/* only from EL1 with the MMU off, and with both ranges in one GiB */
+	cached = (el >> 2) == 1 && !(sctlr & 1) &&
+		 in_cached_gb(out, out_end) && in_cached_gb(self, self_end);
+	if (cached) {
+		lz4_build_tables(out, out_end, self, self_end);
+		/* stale lines from before the bootloader cleaned up must go */
+		lz4_dcache_inval(out, out_end);
+		lz4_dcache_inval(self, self_end);
+		lz4_mmu_on(lz4_l1);
+	}
+
+	size = lz4_legacy_decompress(kernel, (unsigned long) &kernel_size,
+				     (void*)out, CONFIG_KERNEL_LZ4_MAX_SIZE);
+
+	if (cached)
+		lz4_mmu_off(self, self_end, out, out_end, sctlr);
+
+	note_lz4(dt, read_cntvct() - start, sctlr, cached);
+	return size;
+}
+#endif
+
 void arch_load_kernel(void* kernel, void* dt, void* ramdisk)
 {
+#ifdef CONFIG_KERNEL_LZ4
+	long size = unpack_kernel(kernel, dt);
+
+	if (size < 0) {
+		printk(KERN_EMERG, "kernel image is not valid LZ4, hanging\n");
+		HANG();
+	}
+	printk(KERN_INFO, "unpacked %ld bytes of kernel\n", size);
+#else
 	memcpy((void*)CONFIG_PAYLOAD_ENTRY, kernel, (unsigned long) &kernel_size);
+#endif
 #ifndef CONFIG_RAMDISK_NO_COPY
 	__optimized_memcpy((void*)CONFIG_RAMDISK_ENTRY, ramdisk, (unsigned long) &ramdisk_size);
 #endif
diff --git a/arch/aarch64/lz4-cache.S b/arch/aarch64/lz4-cache.S
new file mode 100644
index 0000000..11efff1
--- /dev/null
+++ b/arch/aarch64/lz4-cache.S
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Caches for unpacking an LZ4 kernel. The bootloader enters at EL1 with the
+ * MMU off, where every data access is an uncached Device access and
+ * unpacking 40 MB takes about 9 s. These turn on an identity map with the
+ * caches for the unpacking only, and leave memory clean afterwards.
+ */
+#include "asmdefs.h"
+
+/* MAIR: attr0 Device-nGnRnE, attr1 Normal write-back */
+#define LZ4_MAIR	0xff00
+/* TCR: 32-bit VA (T0SZ 32), 4K granule, WB WA inner shareable walks,
+ * no TTBR1 walks (EPD1), 32-bit PA */
+#define LZ4_TCR		(32 | 1 << 8 | 1 << 10 | 3 << 12 | 1 << 23)
+
+/* \reg = smallest D-cache line size in bytes */
+.macro dcache_line, reg, tmp
+	mrs	\tmp, ctr_el0
+	ubfx	\tmp, \tmp, #16, #4
+	mov	\reg, #4
+	lsl	\reg, \reg, \tmp
+.endm
+
+/* x0 = start, x1 = end: invalidate the D-cache lines of [x0, x1) */
+ENTRY(lz4_dcache_inval)
+	dcache_line x2, x3
+	sub	x3, x2, #1
+	bic	x0, x0, x3
+1:	dc	ivac, x0
+	add	x0, x0, x2
+	cmp	x0, x1
+	b.lo	1b
+	dsb	sy
+	ret
+END(lz4_dcache_inval)
+
+/* x0 = level 1 translation table: MMU, D- and I-cache on */
+ENTRY(lz4_mmu_on)
+	ldr	x1, =LZ4_MAIR
+	msr	mair_el1, x1
+	ldr	x1, =LZ4_TCR
+	msr	tcr_el1, x1
+	msr	ttbr0_el1, x0
+	isb
+	tlbi	vmalle1
+	dsb	nsh
+	isb
+	mrs	x1, sctlr_el1
+	mov	x2, #(1 << 0 | 1 << 2 | 1 << 12)	/* M, C, I */
+	orr	x1, x1, x2
+	msr	sctlr_el1, x1
+	isb
+	ret
+END(lz4_mmu_on)
+
+/*
+ * x0..x1 and x2..x3: ranges to clean and invalidate to the point of
+ * coherency, x4: SCTLR_EL1 to restore (MMU off). No memory writes happen
+ * between the cleaning and the MMU going off.
+ */
+ENTRY(lz4_mmu_off)
+	dcache_line x6, x7
+	sub	x7, x6, #1
+	bic	x0, x0, x7
+1:	dc	civac, x0
+	add	x0, x0, x6
+	cmp	x0, x1
+	b.lo	1b
+	bic	x2, x2, x7
+2:	dc	civac, x2
+	add	x2, x2, x6
+	cmp	x2, x3
+	b.lo	2b
+	dsb	sy
+	msr	sctlr_el1, x4
+	isb
+	ic	iallu
+	dsb	sy
+	isb
+	ret
+END(lz4_mmu_off)
