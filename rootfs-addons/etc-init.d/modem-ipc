#!/sbin/openrc-run
# Minimal RIL side for the Shannon CP (mifmon): holds /dev/umts_ipc0 and
# /dev/umts_rfs0 open (the kernel only completes the CP handshake with
# CMD_INIT_END while both are open), answers the CP's RFS requests (NV data
# and files on EFS; without answers the CP's AT interface stalls) and logs
# every IPC/RFS frame to /var/log/mifmon.log. Starts before cbd so the
# first RFS requests after a CP boot are answered.
#
# MIFMON_DATA=yes in /etc/conf.d/modem-ipc also brings up mobile data on
# rmnet0 (mifmon -d, configured by /usr/local/bin/rmnet-up); MIFMON_APN sets
# the APN (default: network-provided). MIFMON_ATTACH=ipc attaches over Samsung
# IPC instead of AT and leaves the AT port alone (experimental: does not attach).
# MIFMON_MM=yes serves /dev/wwan0at0 (kernel wwan_at_bridge) for
# ModemManager: mifmon proxies its AT commands to umts_router.

description="Shannon CP IPC monitor (mifmon)"

command=/usr/local/bin/mifmon
command_args="-r -e ${ROOT:-/var/lib/android-modem}/efs"
if [ "${MIFMON_MM:-no}" = yes ]; then
	command_args="$command_args -M"
fi
if [ "${MIFMON_DATA:-no}" = yes ]; then
	if [ "${MIFMON_ATTACH:-at}" = ipc ]; then
		command_args="$command_args -I"
	else
		command_args="$command_args -d"
	fi
	command_args="$command_args -s /usr/local/bin/rmnet-up -A '${MIFMON_APN:-}'"
fi
supervisor=supervise-daemon
output_log=/var/log/mifmon.log
error_log=/var/log/mifmon.log

depend() {
	need localmount
	before cbd modemmanager
}

start_pre() {
	# EFS must be mounted where the RFS answers go
	/usr/local/bin/android-env up
}
